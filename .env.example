# ── 데이터베이스 (Railway MySQL) ──
DATABASE_URL="mysql://<user>:<password>@<host>:<port>/<database>"
DATABASE_SSL='{"rejectUnauthorized":true}'

# ── JWT 세션 쿠키 서명 비밀키 (랜덤 문자열, 최소 32자 권장) ──
JWT_SECRET="your-random-secret-here"

# ── Google OAuth 2.0 ──
# Google Cloud Console → APIs & Services → Credentials에서 발급
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ── 이메일 알림 (Gmail SMTP) ──
# Gmail 계정 설정 → 2단계 인증 → 앱 비밀번호 생성
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASS="your-app-password"

# ── 관리자 계정 ──
# 최초 로그인 후 DB의 users 테이블에서 해당 유저의 openId(google_xxxxx)를 복사
OWNER_OPEN_ID="google_your-google-sub-id"

# ── 크론 인증 비밀키 ──
# 크론 서비스에서 아래 헤더로 전송: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="your-cron-secret-here"

# ── Ingest API 인증 비밀키 ──
# 스크래퍼에서 아래 헤더로 전송: Authorization: Bearer <INGEST_API_KEY>
INGEST_API_KEY="your-ingest-api-key-here"

# ── CORS 허용 도메인 ──
# 콤마로 구분, 기본값: https://www.donginfo.com,https://donginfo.com
ALLOWED_ORIGINS="https://www.donginfo.com,https://donginfo.com"

# ── 프론트엔드 설정 (Vite) ──
# 로컬 개발 시 http://localhost:3000, 운영 시 배포 도메인
VITE_API_URL="http://localhost:3000"

# Google OAuth 클라이언트 ID (프론트엔드용 — GOOGLE_CLIENT_ID와 동일값)
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
